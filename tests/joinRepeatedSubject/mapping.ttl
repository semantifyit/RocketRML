@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix ex: <http://www.example.com/> .

<#Shapes>
    rml:logicalSource [ rml:source "./tests/joinRepeatedSubject/shapes.csv"; rml:referenceFormulation ql:CSV ];
    rr:subjectMap [ rr:template "http://example.com/shape/{shape_id}" ];
    rr:predicateObjectMap [
        rr:predicate ex:point;
        rr:objectMap [
            rr:parentTriplesMap <#Points>;
            rr:joinCondition [ rr:child "shape_id"; rr:parent "shape_id" ];
        ];
    ].

<#Points>
    rml:logicalSource [ rml:source "./tests/joinRepeatedSubject/shapes.csv"; rml:referenceFormulation ql:CSV ];
    rr:subjectMap [ rr:template "http://example.com/point/{shape_id}-{seq}" ].
