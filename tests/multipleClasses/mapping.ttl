@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix ex: <http://example.com/> .

<#TriplesMap1>
    rml:logicalSource [ rml:source "./tests/multipleClasses/data.csv"; rml:referenceFormulation ql:CSV ];
    rr:subjectMap [ rr:template "http://example.com/student/{id}"; rr:class ex:Person, ex:Student ].
